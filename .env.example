# Copy to .env and fill in real values. Never commit .env.
# The values below are only for the local PostgreSQL from docker-compose.yml.
# Host port 5433 avoids a clash with a Windows PostgreSQL on 5432.
DATABASE_URL=postgres://pinely:pinely_local_dev@localhost:5433/pinely
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
