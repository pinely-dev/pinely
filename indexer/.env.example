# PostgreSQL (local docker-compose uses port 5433). Ponder writes to the `ponder` schema.
DATABASE_URL=postgres://pinely:pinely_local_dev@localhost:5433/pinely

# 46630 = Robinhood Chain Testnet, 4663 = Robinhood Chain. Required: there is no default network.
CHAIN_ID=46630

# Use a provider endpoint (e.g. Alchemy); the public Robinhood Chain RPC is shared by every user.
# Backfills need an archive endpoint.
RPC_URL=

# Block of the Stage 1 deployment (from the deploy log). Zero is rejected.
START_BLOCK=

# Optional tuning for fast (about 100 ms) blocks.
# POLLING_INTERVAL_MS=2000
# MAX_REQUESTS_PER_SECOND=25
