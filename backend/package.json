{
  "name": "@pinely/backend",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc --noEmit && bun build src/index.ts --target bun --outdir dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/seed.ts",
    "queue:spike": "bun run scripts/pg-boss-spike.ts"
  },
  "dependencies": {
    "@pinely/shared": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.13.10",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.7",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
