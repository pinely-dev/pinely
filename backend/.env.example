# Copy to backend/.env for local development. Never commit .env.

# Local PostgreSQL (docker compose up -d postgres).
# Host port 5433 avoids a clash with a Windows PostgreSQL on 5432.
DATABASE_URL=postgres://pinely:pinely_local_dev@localhost:5433/pinely
DATABASE_SCHEMA=app
PONDER_SCHEMA=ponder

# Server
PORT=3001
# Must be 'development' or 'test' for local work. When unset the backend refuses to use the
# development session secret and local database credentials.
NODE_ENV=development
LOG_LEVEL=info

# Allowed browser origins, comma separated. No wildcards: credentials are enabled.
FRONTEND_URL=http://localhost:3000
# Extra domains allowed to request a SIWE sign-in (the FRONTEND_URL hosts are always allowed).
# Hosting-platform wildcards such as *.vercel.app are never accepted.
ALLOWED_AUTH_DOMAINS=

# Network. 46630 = Robinhood Chain Testnet, 4663 = Robinhood Chain. Mandatory in production.
CHAIN_ID=46630
# Use a provider endpoint (e.g. Alchemy). The public Robinhood Chain RPC is shared by every user.
RPC_URL=

# Contract addresses are NOT configured here. They come from @pinely/shared
# (deployments: `bun run sync`; external tokens and infra: shared/contracts/external.ts).

# --- Settlement (HTTP 402 facilitator, ERC-4337 rail) ---
# Every settlement is an ERC-4337 UserOperation. The stablecoin may also support EIP-3009, but that rail is not used.
BUNDLER_RPC_URL=
MERCHANT_ADDRESS=
FACILITATOR_PUBLIC_URL=
# Optional facilitator fee. The fee is transferred in the same UserOperation; without a recipient it is 0.
FACILITATOR_FEE_RECIPIENT=
FACILITATOR_FEE_BPS=10
# Local simulation only (ignored in production): settles without a bundler and marks results simulated.
FACILITATOR_SIMULATION=false

# Keeper (surplus sweeps). Without a valid key the keeper runs as a dry run (nothing is sent).
# Use a dedicated low-balance key stored as a deployment secret: never the deployer, a Safe owner, or the
# facilitator key (the facilitator key is not used here). It only pays gas; sweeps are permissionless.
KEEPER_PRIVATE_KEY=

# Auth (at least 32 random characters; required outside development/test)
SESSION_SECRET=
FACILITATOR_TOKEN_SECRET=

# Registration fee approved by operators, in stablecoin base units. Must equal MachineRegistry.registrationFee().
REGISTRATION_FEE=2000000
