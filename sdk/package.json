{
  "name": "@pinely/sdk",
  "version": "0.1.0",
  "description": "PINELY SDK: hardware machine onboarding, session keys, swap signing, and HTTP 402 payments on Robinhood Chain",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "pinely": "./bin/pinely.ts",
    "pinely-cli": "./bin/pinely.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./keystore": "./src/keystore/index.ts",
    "./types": "./src/types/index.ts"
  },
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "cli": "bun run ./bin/pinely.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@pinely/shared": "workspace:*",
    "viem": "^2.56.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "~5.9.3"
  }
}
