{
  "name": "@pinely-protocol/sdk",
  "version": "0.1.0-beta.1",
  "description": "PINELY SDK: hardware machine onboarding, session keys, swap signing, and HTTP 402 payments on Robinhood Chain",
  "license": "MIT",
  "keywords": [
    "pinely",
    "depin",
    "robinhood-chain",
    "erc-4337",
    "account-abstraction",
    "x402",
    "viem"
  ],
  "homepage": "https://github.com/pinely-dev/pinely/tree/main/sdk#readme",
  "bugs": "https://github.com/pinely-dev/pinely/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinely-dev/pinely.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "pinely": "./bin/pinely.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./keystore": "./src/keystore/index.ts",
    "./types": "./src/types/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "bun run ./bin/pinely.ts",
    "build": "tsup && node ./scripts/prepare-publish.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@pinely/shared": "workspace:*",
    "viem": "^2.56.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3"
  }
}
