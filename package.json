{
  "name": "pinely",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "contracts",
    "indexer",
    "sdk"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:indexer": "bun run --cwd indexer dev",
    "build": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "build:indexer": "bun run --cwd indexer build",
    "build:sdk": "bun run --cwd sdk build",
    "test:sdk": "bun run --cwd sdk test",
    "test:backend": "bun run --cwd backend test",
    "test:python": "python -m unittest discover -s sdk-python/tests -t sdk-python",
    "typecheck": "bun run --cwd frontend typecheck && bun run --cwd backend typecheck && bun run --cwd indexer typecheck && bun run --cwd sdk typecheck",
    "lint": "bun run --cwd frontend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:seed": "bun run --cwd backend db:seed",
    "contracts:build": "bun run --cwd contracts build",
    "contracts:test": "bun run --cwd contracts test",
    "contracts:fmt": "bun run --cwd contracts fmt",
    "contracts:fmt:check": "bun run --cwd contracts fmt:check",
    "sync": "bun scripts/sync-contracts.mjs",
    "deploy:preflight": "bun scripts/deploy-preflight.mjs",
    "check:legacy": "bun scripts/check-no-legacy-chain.mjs",
    "contracts:deploy:poolmanager:testnet": "bun run --cwd contracts deploy:poolmanager:testnet",
    "contracts:deploy:testnet": "bun run --cwd contracts deploy:testnet",
    "contracts:deploy:testnet:stage1:dry": "bun run --cwd contracts deploy:testnet:stage1:dry",
    "contracts:deploy:testnet:stage1": "bun run --cwd contracts deploy:testnet:stage1",
    "contracts:deploy:mainnet:stage1:dry": "bun run --cwd contracts deploy:mainnet:stage1:dry",
    "contracts:deploy:mainnet:stage1:verify": "bun run --cwd contracts deploy:mainnet:stage1:verify",
    "contracts:deploy:mainnet:stage1": "bun run --cwd contracts deploy:mainnet:stage1",
    "contracts:deploy:mainnet:stage2": "bun run --cwd contracts deploy:mainnet:stage2"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
