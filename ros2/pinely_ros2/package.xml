<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinely_ros2</name>
  <version>0.1.0</version>
  <description>ROS2 Node and Service Interfaces for PINELY Autonomous Machine Financial Protocol on Robinhood Chain</description>
  <maintainer email="">PINELY Robotics Engineering</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
