# Backend PINELY API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Data source mode: "api" (live indexer & backend on testnet) or "sample" (demo UI)
NEXT_PUBLIC_DATA_SOURCE=api

# Active Chain ID (Robinhood Chain Testnet: 46630, Robinhood Chain: 4663)
NEXT_PUBLIC_CHAIN_ID=46630
# Public origin of the site, used for canonical links, Open Graph and the sitemap.
# Required for a production build unless Vercel provides VERCEL_PROJECT_PRODUCTION_URL.
# Use the real domain once it exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
