# Copy to contracts/.env for `forge script`. Never commit .env.
# The deployer private key is NOT stored here: use a Foundry encrypted keystore.
#   cast wallet import deployer-robinhood-testnet --interactive
#   cast wallet import deployer-robinhood --interactive

# Robinhood Chain RPC endpoints (see foundry.toml [rpc_endpoints]). Use a provider endpoint for mainnet.
RPC_URL_ROBINHOOD_TESTNET=https://rpc.testnet.chain.robinhood.com
RPC_URL_ROBINHOOD_MAINNET=

# Public address of the deployer keystore account. Required so that Foundry associates ownership and
# predicts the router address correctly. Must never be the default Foundry or Anvil account.
DEPLOYER_ADDRESS=

# Addresses used by script/Deploy*.s.sol. Take external addresses only from the official Robinhood Chain
# documentation, never from an explorer or a community channel.
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
STABLECOIN_ADDRESS=
# Mainnet: a Safe with threshold 2 and exactly 3 owners (the deployer must not be an owner).
TREASURY_ADDRESS=

# Stage 2 (testnet rehearsal until the $PINELY token launches)
POOL_MANAGER=
PINELY_TOKEN_ADDRESS=
# Plain (no hook) $PINELY/stablecoin pool the buyback executor is bound to for good. Required on mainnet.
# They must match the pool PoolSeeder initialises with executor.poolKey(). Decided 2026-11-14: 0.30% and 60.
BUYBACK_POOL_FEE=3000
BUYBACK_POOL_TICK_SPACING=60
REGISTRY_ADDRESS=
PAYMASTER_ADDRESS=

# Testnet only: deploy mocks when the canonical tokens are unavailable.
ALLOW_MOCK_STABLECOIN=false
ALLOW_MOCK_PINELY_TOKEN=false

# Paymaster price circuit breaker: bounds for the owner-set price of ONE native token (ETH), in USD with 8 decimals.
# Required on every chain (no default). They catch a mistyped price (an extra or missing zero), not market drift:
# use roughly 0.5x and 2x of the reference price at deploy time. The script refuses a window wider than 10x.
# Illustration only, not a recommendation: a reference price of 3,000 gives 150000000000 and 600000000000.
NATIVE_PRICE_MIN=
NATIVE_PRICE_MAX=

# Registration fee in stablecoin base units (6 decimals). Default 2 units.
REGISTRATION_FEE=2000000

# Block explorer verification (Blockscout fork): confirm the verifier URL from the official docs first.
ETHERSCAN_API_KEY=
