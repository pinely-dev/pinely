{
  "name": "@pinely/contracts",
  "private": true,
  "version": "0.0.1",
  "description": "PINELY contracts \u2014 Foundry",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "deploy:poolmanager:testnet": "forge script script/DeployPoolManager.s.sol:DeployPoolManager --rpc-url robinhood_testnet --account deployer-robinhood-testnet --broadcast",
    "deploy:testnet": "forge script script/DeployTestnet.s.sol:DeployTestnet --rpc-url robinhood_testnet --account deployer-robinhood-testnet --broadcast",
    "deploy:testnet:stage1:dry": "forge script script/DeployStage1.s.sol:DeployStage1 --rpc-url robinhood_testnet",
    "deploy:testnet:stage1": "forge script script/DeployStage1.s.sol:DeployStage1 --rpc-url robinhood_testnet --account deployer-robinhood-testnet --broadcast",
    "deploy:testnet:stage1:verify": "forge script script/DeployStage1.s.sol:DeployStage1 --rpc-url robinhood_testnet --account deployer-robinhood-testnet --broadcast --verify --verifier blockscout --verifier-url https://explorer.testnet.chain.robinhood.com/api/",
    "deploy:mainnet:stage1:verify": "forge script script/DeployStage1.s.sol:DeployStage1 --rpc-url robinhood_mainnet --account deployer-robinhood --broadcast --verify --verifier blockscout --verifier-url https://robinhoodchain.blockscout.com/api/",
    "deploy:mainnet:stage1:dry": "forge script script/DeployStage1.s.sol:DeployStage1 --rpc-url robinhood_mainnet",
    "deploy:mainnet:stage1": "forge script script/DeployStage1.s.sol:DeployStage1 --rpc-url robinhood_mainnet --account deployer-robinhood --broadcast",
    "deploy:mainnet:stage2": "forge script script/DeployStage2.s.sol:DeployStage2 --rpc-url robinhood_mainnet --account deployer-robinhood --broadcast"
  }
}
